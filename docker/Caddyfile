{
	admin off
}

:8081 {
	bind 127.0.0.1
	respond /healthz "ok"
}

{$SITE_ADDRESS} {
	encode zstd gzip
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Cache-Control "no-store"
	}
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:backend:3000} {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
