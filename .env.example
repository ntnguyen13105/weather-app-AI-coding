# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:3000
# scripts/start-local-db.ps1 generates a private password and this URL locally.
DATABASE_URL=postgresql://weather_app:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:55432/weather_app?schema=public
# Leave blank during phase 3. Phase 4 will require the real Free API key.
OPENWEATHER_API_KEY=
# Phase 4 authentication: generate independent random secrets (at least 32 bytes).
JWT_SECRET=
CSRF_SECRET=
